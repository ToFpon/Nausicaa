#: nausicaa/app.py:30
msgid "Afficher la version"
msgstr "Show the version"

#: nausicaa/app.py:32
msgid "Ajouter à la file au lieu de la remplacer"
msgstr "Add to the queue instead of replacing it"

#: nausicaa/app.py:188
msgid "Inspiré de"
msgstr "Inspired by"

#: nausicaa/app.py:189
msgid "Moteurs"
msgstr "Engines"

#: nausicaa/app.py:167
msgid "Lecture d'une vidéo"
msgstr "Playing a video"

#: nausicaa/app.py:183
msgid "Un petit lecteur vidéo pour GNOME, qui lit vos vidéos et rien d'autre."
msgstr "A small video player for GNOME that plays your videos, and nothing else."

#: nausicaa/backend/controller.py:328
msgid "Ce fichier ne peut pas être lu."
msgstr "This file cannot be played."

#: nausicaa/backend/controller.py:330
msgid "Le fichier n'existe plus."
msgstr "The file no longer exists."

#: nausicaa/features.py:25
msgid "Clic pour mettre en pause"
msgstr "Click to pause"

#: nausicaa/features.py:26
msgid "Un clic gauche sur l'image met en pause ou relance, comme VLC ; un double-clic passe en plein écran sans mettre en pause"
msgstr "A left click on the picture pauses or resumes, like VLC; a double-click switches to full screen without pausing"

#: nausicaa/features.py:29
msgid "Volume à la molette"
msgstr "Wheel volume"

#: nausicaa/features.py:30
msgid "La molette de la souris sur l'image règle le volume, affiché par-dessus la vidéo"
msgstr "The mouse wheel over the picture sets the volume, shown over the video"

#: nausicaa/features.py:32
msgid "Pause quand la fenêtre est réduite"
msgstr "Pause when the window is minimised"

#: nausicaa/features.py:33
msgid "La lecture s'arrête quand la fenêtre est réduite et reprend quand elle revient"
msgstr "Playback pauses when the window is minimised and resumes when it comes back"

#: nausicaa/features.py:35
msgid "Reprendre où on s'était arrêté"
msgstr "Resume where you left off"

#: nausicaa/features.py:36
msgid "Une vidéo rouverte repart de l'endroit où on l'avait quittée"
msgstr "A reopened video starts again where you left it"

#: nausicaa/features.py:38
msgid "Épisodes suivants"
msgstr "Following episodes"

#: nausicaa/features.py:39
msgid "Ouvrir une seule vidéo ajoute à la file les autres vidéos de son dossier, dans l'ordre des noms (« Épisode 2 » avant « Épisode 10 »)"
msgstr "Opening a single video adds the other videos of its folder to the queue, in name order (“Episode 2” before “Episode 10”)"

#: nausicaa/features.py:42
msgid "Contrôle depuis le système"
msgstr "System controls"

#: nausicaa/features.py:43
msgid "Panneau de GNOME, touches multimédia du clavier et boutons d'un casque Bluetooth (MPRIS)"
msgstr "GNOME panel, keyboard media keys and the buttons of a Bluetooth headset (MPRIS)"

#: nausicaa/features.py:45
msgid "Décodage matériel"
msgstr "Hardware decoding"

#: nausicaa/features.py:46
msgid "La carte graphique décode la vidéo quand elle le peut : moins de travail pour le processeur"
msgstr "The graphics card decodes the video when it can: less work for the processor"

