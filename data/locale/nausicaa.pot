#: nausicaa/features.py:25
msgid "Clic pour mettre en pause"
msgstr ""

#: nausicaa/features.py:26
msgid "Un clic gauche sur l'image met en pause ou relance, comme VLC ; un double-clic passe en plein écran sans mettre en pause"
msgstr ""

#: nausicaa/features.py:29
msgid "Signe de pause et de lecture"
msgstr ""

#: nausicaa/features.py:30
msgid "Une icône ⏸ ou ▶ apparaît brièvement au centre de l'image quand on met en pause ou qu'on reprend"
msgstr ""

#: nausicaa/features.py:32
msgid "Volume à la molette"
msgstr ""

#: nausicaa/features.py:33
msgid "La molette de la souris sur l'image règle le volume, affiché par-dessus la vidéo"
msgstr ""

#: nausicaa/features.py:35
msgid "Pause quand la fenêtre est réduite"
msgstr ""

#: nausicaa/features.py:36
msgid "La lecture s'arrête quand la fenêtre est réduite et reprend quand elle revient"
msgstr ""

#: nausicaa/features.py:38
msgid "Reprendre où on s'était arrêté"
msgstr ""

#: nausicaa/features.py:39
msgid "Une vidéo rouverte repart de l'endroit où on l'avait quittée"
msgstr ""

#: nausicaa/features.py:41
msgid "Épisodes suivants"
msgstr ""

#: nausicaa/features.py:42
msgid "Ouvrir une seule vidéo ajoute à la file les autres vidéos de son dossier, dans l'ordre des noms (« Épisode 2 » avant « Épisode 10 »)"
msgstr ""

#: nausicaa/features.py:45 nausicaa/ui/window.py:302
msgid "Passer le générique"
msgstr ""

#: nausicaa/features.py:46
msgid "Pendant le générique de fin d'un épisode, un bouton « Épisode suivant ». Le générique est trouvé dans les chapitres de la vidéo, sinon appris : « Le générique commence ici » (clic droit ou G) une fois, et Nausicaa le retient pour toute la série"
msgstr ""

#: nausicaa/features.py:50
msgid "Contrôle depuis le système"
msgstr ""

#: nausicaa/features.py:51
msgid "Panneau de GNOME, touches multimédia du clavier et boutons d'un casque Bluetooth (MPRIS)"
msgstr ""

#: nausicaa/features.py:53
msgid "Titre enregistré dans le fichier"
msgstr ""

#: nausicaa/features.py:54
msgid "Afficher le titre que la vidéo porte en elle (« Série - S02E04 - Titre ») au lieu du nom du fichier, quand il en a un qui a du sens"
msgstr ""

#: nausicaa/features.py:57
msgid "Plein écran à l'ouverture"
msgstr ""

#: nausicaa/features.py:58
msgid "Une vidéo ouverte (gestionnaire de fichiers, « Ouvrir », glisser) passe directement en plein écran, comme VLC ; pas un fichier audio, ni une vidéo ajoutée à la file"
msgstr ""

#: nausicaa/features.py:61
msgid "Bibliothèque sur l'accueil"
msgstr ""

#: nausicaa/features.py:62
msgid "L'accueil montre vos vidéos : à reprendre, séries (une affiche par série, ses saisons et ses épisodes vus) et films. Dossiers choisis dans Préférences → Général ; affiches trouvées à côté des vidéos ou tirées des vidéos elles-mêmes, sans Internet"
msgstr ""

#: nausicaa/features.py:66 nausicaa/ui/preferences.py:117
msgid "Affiches de TMDB"
msgstr ""

#: nausicaa/features.py:67
msgid "Bibliothèque : pour les séries et les films sans image posée à côté, l'affiche de themoviedb.org, dans la langue de Nausicaa. Les titres sont envoyés à TMDB ; demande votre propre clé d'API, gratuite (Préférences → Général → Bibliothèque)"
msgstr ""

#: nausicaa/features.py:71
msgid "Décodage matériel"
msgstr ""

#: nausicaa/features.py:72
msgid "La carte graphique décode la vidéo quand elle le peut : moins de travail pour le processeur"
msgstr ""

